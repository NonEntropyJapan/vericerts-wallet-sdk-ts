{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/src/internal/identity/webvh/__tests__/conformance/didwebvh-test-suite",
      "!**/test/conformance/ext/conformance-vectors-ext.json",
      "!**/dist",
      "!**/coverage",
      "!**/sbom",
      "!**/.build-meta-*.json",
      "!**/schemas/error-codes.json",
      "!**/schemas/log-entry.json",
      "!**/schemas/conformance-vectors.json"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@noble/curves/ed25519.js": "Ed25519 は src/internal/keymanager/ed25519.ts 経由で使うこと。@noble を直接呼ぶと既定の zip215: true になり、SDK の RFC 8032 準拠の検証と受理する署名が異なる。"
            }
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/internal/keymanager/ed25519.ts", "**/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
