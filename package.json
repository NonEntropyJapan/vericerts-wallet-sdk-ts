{
  "name": "vericerts-wallet-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "VeriCerts Wallet SDK — did:key/did:ethr, VC/VP (SD-JWT / JWT-VC), OID4VCI/OID4VP を扱うウォレット SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NonEntropyJapan/vericerts-wallet-sdk-ts.git"
  },
  "homepage": "https://github.com/NonEntropyJapan/vericerts-wallet-sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/NonEntropyJapan/vericerts-wallet-sdk-ts/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/cjs-types/index.d.ts",
